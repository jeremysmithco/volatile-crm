<%= render PageLayouts::BasicComponent.new(title: "Companies", debug: @debug) do |c| %>
  <%= c.with_action_link(text: "New", path: new_company_path) %>
  <%= c.with_action_link(text: "Settings", path: new_company_path, colors: "bg-gray-500 hover:bg-gray-700") %>

  <%= c.with_body do %>
    <%= render "table", companies: @companies %>
  <% end %>
<% end %>

<%= render PageLayouts::BasicComponent.new(title: @company.name, debug: @debug) do |c| %>
  <%= c.with_parent(title: "Companies", link: companies_path) %>

  <%= c.with_action_button(text: "Duplicate", path: new_company_path) %>
  <%= c.with_action_button(text: "Delete", path: company_path(@company), method: :delete, colors: "bg-rose-500 hover:bg-rose-700") %>

  <%= c.with_body do %>
    <%= render "form", company: @company %>
  <% end %>
<% end %>
