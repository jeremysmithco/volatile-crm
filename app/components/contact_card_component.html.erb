<%= link_to(contact_path(contact), class: wrapper_classes) do %>
  <%= tag.div(class: body_classes) do %>
    <%= tag.div do %>
      <%= tag.div(class: header_classes) do %>
        <%= tag.span(contact.full_name, class: name_classes) %>
        <%= tag.span(contact.company.name) %>
      <% end %>

      <%= detail(icon: "map-pin", field: contact.location) %>
      <%= detail(icon: "envelope", field: contact.email, color: "text-cyan-500") %>
      <%= detail(icon: "phone", field: contact.phone) %>
    <% end %>

    <%= avatar %>
  <% end %>

  <% if contact.social? %>
    <%= tag.div(class: footer_classes) do %>
      <%= social(icon: "linkedin", field: contact.linkedin) %>
      <%= social(icon: "github", field: contact.github) %>
      <%= social(icon: "twitter", field: contact.twitter) %>
    <% end %>
  <% end %>
<% end %>
