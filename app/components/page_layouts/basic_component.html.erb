<%= tag.div(class: wrapper_classes) do %>
  <%= tag.div(class: header_classes) do %>
    <%= tag.div(class: title_classes) do %>
      <% if parent? %>
        <%= parent %>
        <%= tag.div(render("icons/divider"), class: divider_classes) %>
      <% end %>

      <%= tag.div(title) %>
    <% end %>

    <%= tag.div(action, class: action_classes) %>
  <% end %>

  <%= tag.div(body, class: body_classes) %>
<% end %>
